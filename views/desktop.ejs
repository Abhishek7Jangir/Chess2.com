<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ChessMasterEJSdesktop</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #1a1a1a;
            color: #fff;
            background-image: url('/images/chess-board-bg.jpg');
            background-size: cover;
            background-position: center;
        }

        header {
            background-color: #333;
            color: white;
            padding: 1rem 0;
            text-align: center;
        }

        header h1 {
            margin: 0;
            font-size: 2rem;
        }

        header img {
            width: 50px;
            height: 50px;
            vertical-align: middle;
        }

        nav {
            display: flex;
            justify-content: center;
            background-color: #444;
            padding: 0.5rem 0;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 0 15px;
            font-size: 1rem;
            transition: color 0.3s;
        }

        nav a:hover {
            color: #ffcc00;
        }

        .hero {
            text-align: center;
            padding: 4rem 1rem;
            background: url('/images/chess-hero.jpg') no-repeat center center/cover;
            color: white;
        }

        .hero h2 {
            font-size: 2.5rem;
            margin-bottom: 1rem;
        }

        .hero p {
            font-size: 1.2rem;
            margin-bottom: 2rem;
        }

        .hero button {
            background-color: #ffcc00;
            color: #333;
            padding: 12px 30px;
            border: none;
            border-radius: 6px;
            font-size: 1rem;
            cursor: pointer;
            transition: background-color 0.3s;
        }

        .hero button:hover {
            background-color: #e6b800;
        }

        .buttons {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 15px;
            margin-top: 2rem;
        }

        .buttons a {
            background-color: #333;
            color: white;
            padding: 10px 20px;
            border-radius: 5px;
            text-decoration: none;
            font-size: 1rem;
            transition: background-color 0.3s;
        }

        .buttons a:hover {
            background-color: #555;
        }

        footer {
            text-align: center;
            padding: 1rem 0;
            background-color: #333;
            color: white;
            margin-top: 2rem;
        }

        @media (max-width: 768px) {
            .hero h2 {
                font-size: 2rem;
            }

            .hero p {
                font-size: 1rem;
            }

            nav a {
                margin: 0 10px;
                font-size: 0.9rem;
            }
        }
    </style>
</head>
<body>
    <header>
        <h1><img src="/images/logo.png" alt="Logo"> ChessMaster</h1>
    </header>
    <nav>
        <a href="#about">About</a>
        <a href="/signup">Sign Up</a>
        <a href="/signin">Sign In</a>
        <a href="#contact">Contact Us</a>
        <a href="#analysis">Game Analysis</a>
    </nav>
    <section class="hero">
        <h2>Welcome to ChessMaster</h2>
        <p>Challenge yourself, analyze your games, and become a grandmaster!</p>
        <div class="buttons">
            <a href="/signup">Sign Up</a>
            <a href="/signin">Sign In</a>
            <a href="#analysis">Game Analysis</a>
        </div>
    </section>
    <footer>
        <p>&copy; 2023 ChessMaster. All rights reserved.</p>
    </footer>
</body>
</html>























