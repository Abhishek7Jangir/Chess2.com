<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>

    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        /* Background */
        body {
            background: linear-gradient(to bottom right, #0f2027, #203a43, #2c5364);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 0;
        }

        /* Main Container */
        .game-container {
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(8px);
            padding: 20px;
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
        }

        /* Player Info (Name + Timer + Captures) */
        .player-info {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: white;
            font-weight: bold;
            padding: 5px 20px;
        }

        .captured-pieces {
            display: flex;
            gap: 5px;
            font-size: 24px;
        }

        .timer {
            background: #222;
            padding: 5px 10px;
            border-radius: 8px;
            font-size: 18px;
        }

        /* Chessboard (✅ Your original colors) */
        .chessboard {
            display: grid;
            grid-template-columns: repeat(8, minmax(0, 1fr));
            grid-template-rows: repeat(8, minmax(0, 1fr));
            width: 75vh;
            height: 75vh;
            transform: rotate(0deg);
            border-radius: 10px;
            overflow: hidden;
        }

        .square {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .square.light {
            background-color: #f0d9b5af;
        }

        .square.dark {
            background-color: #b58863cd;
        }

        /* Piece Styling */
        .piece {
            font-family: 'Segoe UI Symbol', 'Arial', sans-serif;
            font-size: 6vh;
            cursor: grab;
            background: none;
        }

        .white-piece {
            color: white;
        }

        .black-piece {
            color: black;
        }

        select,
        button {
            font-size: 18px;
        }

        button {
            background-color: #4CAF50;
            padding: 10px 20px;
            color: white;
            border: none;
            border-radius: 5px;
            font-weight: bold;
            transition: background-color 0.3s;
            width: 15vh;
        }

        button:hover {
            background-color: #45a049;
        }

        /* 📱 Responsive Adjustments */
        @media (max-width: 1024px) {
            .game-container {
                width: 95vw;
                padding: 16px;
            }

            .chessboard {
                width: 90vw;
                height: 90vw;
            }

            .piece {
                font-size: 8vw;
            }

            .captured-pieces {
                font-size: 1.5rem;
            }

            .player-info {
                flex-direction: column;
                align-items: flex-start;
                gap: 8px;
            }

            button {
                width: 100%;
                max-width: 200px;
            }
        }
    </style>
</head>

<body>
    <div class="game-container">
        <!-- Start Menu -->
        <div id="startArea" class="flex flex-col items-center gap-4">
            <label for="difficulty" class="text-white text-xl">Select Difficulty:</label>
            <select id="difficulty" class="text-black p-2 rounded">
                <option value="easy">Easy</option>
                <option value="medium" selected>Medium</option>
                <option value="hard">Hard</option>
            </select>
            <button id="startGame">Start Game</button>
        </div>

        <!-- Chess Area -->
        <div id="chessArea" class="hidden flex flex-col items-center gap-2">
            <!-- Top Player (Opponent AI) -->
            <div class="player-info">
                <div id="opponentName">Stockfish</div>
                <div id="capturedByPlayer" class="captured-pieces"></div>
                <div id="opponentTimer" class="timer">10:00</div>
            </div>

            <!-- Chessboard -->
            <div class="chessboard" id="chessboard"></div>

            <!-- Bottom Player (You) -->
            <div class="player-info">
                <div id="playerName">You</div>
                <div id="capturedByOpponent" class="captured-pieces"></div>
                <div id="playerTimer" class="timer">10:00</div>
            </div>
        </div>
    </div>

    <!-- JavaScript -->
    <script src="https://cdn.socket.io/4.8.1/socket.io.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js"></script>
    <script src="/public/js/scriptAi.js"></script>
    <script>
        const USER_ID_FROM_SESSION = <%= userId %>;
    </script>
</body>

</html>
