<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chess PGN Analyzer</title>
    <link rel="stylesheet" href="/public/css/analysis.css">
</head>
<body>
    <div class="container">
        <h1>Analyze Chess Game</h1>
        <% if (locals.error) { %>
            <div class="error-message"><%= error %></div>
        <% } %>
        <form action="/analysis/analyze" method="post">
            <label for="pgn">Enter Chess PGN:</label>
            <textarea id="pgn" name="pgn" rows="10" placeholder="Paste your PGN here..."></textarea>
            <button type="submit">Analyze Game</button>
        </form>
    </div>
</body>
</html>
